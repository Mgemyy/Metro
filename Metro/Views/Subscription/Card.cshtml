@model MetroApp.Models.Subscription

@{
    ViewData["Title"] = "Digital Metro Pass";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-primary shadow text-center">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">Cairo Metro Digital Pass</h5>
                </div>
                <div class="card-body p-4">
                    <img src="@Model.PersonalPhotoPath" class="rounded-circle mb-3 border" width="100" height="100" style="object-fit: cover;" alt="User Photo" />
                    <h4 class="fw-bold mb-1">@Model.User.FullName</h4>
                    <span class="badge bg-secondary mb-3">@Model.Type Subscription</span>

                    <div class="alert alert-light border my-3">
                        <p class="mb-1"><strong>Route:</strong> @Model.StartStation.Name ➔ @Model.EndStation.Name</p>
                        <p class="mb-0"><strong>Valid Until:</strong> @Model.EndDate?.ToString("yyyy-MM-dd")</p>
                    </div>

                    <!-- Render Base64 QR Code -->
                    <img src="@ViewBag.QrCodeImage" alt="Metro QR Pass" class="img-fluid border p-2 mb-3" style="width: 180px; height: 180px;" />

                    <div class="text-muted small">Scan this code at smart metro turnstiles</div>
                </div>
                <div class="card-footer bg-light">
                    <button onclick="window.print()" class="btn btn-outline-dark btn-sm">Print Card</button>
                    <a asp-action="MySubscriptions" class="btn btn-secondary btn-sm">Back</a>
                </div>
            </div>
        </div>
    </div>
</div>
