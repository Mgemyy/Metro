@model IEnumerable<MetroApp.Models.Subscription>

@{
    ViewData["Title"] = "My Subscriptions";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Metro Subscriptions</h2>
        <a asp-action="Create" class="btn btn-success">+ Request New Subscription</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You don't have any subscription requests yet. Click the button above to apply.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Route</th>
                        <th>Type</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Documents</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.RequestDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.StartStation.Name ➔ @item.EndStation.Name</td>
                            <td>@item.Type</td>
                            <td>@item.TotalPrice.ToString("C")</td>
                            <td>
                                @if (item.Status == MetroApp.Models.Enums.SubscriptionStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending Review</span>
                                }
                                else if (item.Status == MetroApp.Models.Enums.SubscriptionStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }
                            </td>
                            <td>
                                <a href="@item.PersonalPhotoPath" target="_blank" class="btn btn-sm btn-outline-secondary">Photo</a>
                                <a href="@item.NationalIdPhotoPath" target="_blank" class="btn btn-sm btn-outline-secondary">ID</a>
                                @if (!string.IsNullOrEmpty(item.AdditionalDocumentPath))
                                {
                                    <a href="@item.AdditionalDocumentPath" target="_blank" class="btn btn-sm btn-outline-secondary">Proof</a>
                                }
                            </td> 
                            @if (item.Status == MetroApp.Models.Enums.SubscriptionStatus.Approved)
                            {
                                <a asp-action="Card" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Show QR Pass</a>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
