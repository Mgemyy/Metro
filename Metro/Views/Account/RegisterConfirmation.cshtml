@{
    ViewData["Title"] = "Confirm Your Email";
}

<div class="container mt-5 text-center">
    <div class="card shadow-sm p-4 col-md-8 mx-auto">
        <h3 class="text-primary mb-3">Registration Successful!</h3>
        <p class="text-muted">A verification link has been sent to your email.</p>

     

        <div class="mt-3">
            <a asp-action="Login" class="btn btn-outline-secondary">Go to Login</a>
        </div>
    </div>
</div>
